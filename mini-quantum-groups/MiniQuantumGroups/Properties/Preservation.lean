def fusion_product (j k : Nat) : List Nat :=
  let min_val := if j ≥ k then j - k else k - j
  (List.range (j + k + 1 - min_val)).map (λ l => min_val + l)
#eval fusion_product 1 1
#eval fusion_product 2 1
