/-
# MiniVertexAlgebras.Examples.HeisenbergVOA

The Heisenberg (free boson) vertex operator algebra: the fundamental
example of a VOA. State space is the Fock space of a free boson,
central charge c = 1, generated by a weight-1 field b(z).

L6: Canonical example — Heisenberg VOA with #eval verification
L7: Application — Free boson CFT
-/

import MiniVertexAlgebras.Core.Basic
import MiniVertexAlgebras.Core.AxiomEquivalence
import MiniVertexAlgebras.Core.AxiomCompat

namespace MiniVertexAlgebras


/-! ## Heisenberg Lie Algebra

The Heisenberg algebra (oscillator algebra) is generated by b_n (n in Z)
and a central element K with relations:
[b_m, b_n] = m delta_{m+n, 0} K

The Fock space representation is built on a vacuum |0> annihilated
by b_n for n >= 0. The state space is isomorphic to the polynomial
simp Q[x_1, x_2, ...] where x_n corresponds to b_{-n}|0>.

We define a simplified finite-dimensional truncation for #eval purposes. -/

/-! ## Truncated Fock Space

For computational purposes, we work with a truncated Fock space
where we keep only finitely many modes. The state space is
polynomials in N variables x_1, ..., x_N up to degree D.

Each monomial x_1^{e_1} ... x_N^{e_N} corresponds to the state
(b_{-1})^{e_1} ... (b_{-N})^{e_N} |0>. -/

structure TruncatedFockSpace where
  numModes : Nat
  maxDegree : Nat
  -- A monomial is represented as a list of exponents
  -- Full state is a list of coefficient-monomial pairs

/-- Generate monomials up to given max degree -/
def generateMonomials (numModes maxDegree : Nat) : List (List Nat) :=
  -- For numModes=2, maxDegree=2:
  -- [[0,0], [1,0], [0,1], [2,0], [1,1], [0,2]]
  let rec go (remaining : Nat) (current : List Nat) (deg : Nat) : List (List Nat) :=
    match remaining with
    | 0 => if deg <= maxDegree then [current.reverse] else []
    | n+1 =>
      let results := List.range (maxDegree - deg + 1)
      results.bind λ e =>
        go n (e :: current) (deg + e)
  go numModes [] 0

/-- Construct a state in the truncated Fock space as a list of
(coefficient, monomial) pairs. -/
def FockState := List (Int × List Nat)

/-- Zero state -/
def fockZero : FockState := []

/-- Add two Fock states (combine like terms) -/
def fockAdd (s1 s2 : FockState) : FockState :=
  let combined := s1 ++ s2
  -- Group by monomial and sum coefficients
  -- Simplified: just concatenate
  combined

/-- Scalarly multiply a Fock state -/
def fockSmul (r : Int) (s : FockState) : FockState :=
  s.map λ (c, m) => (r * c, m)

/-- Vacuum state |0> = 1 * [] -/
def fockVacuum : FockState := [(1, [])]

-- Note: For the actual Heisenberg VOA, the state space is infinite-dimensional.
-- The truncated version is used only for computational demonstration.

/-! ## Heisenberg Modes

For the Heisenberg algebra, b_n acts on the Fock space:
- b_{-n} = multiplication by x_n (creation)
- b_n = n * partial/partial x_n (annihilation) for n > 0
- b_0 = 0 (on the Fock space)

We define the action on monomials combinatorially. -/

/-- Action of b_n on a monomial represented as exponents [e_1, ..., e_N] --/
def heisenbergMode (n : Int) (exponents : List Nat) : List (Int × List Nat) :=
  if n > 0 then
    -- Annihilation: b_n = n * d/dx_n
    -- If e_n > 0, decrease e_n by 1 and multiply by n * e_n
    match exponents.get? (n.natAbs - 1) with
    | some e =>
      if e > 0 then
        let newExp := exponents.set (n.natAbs - 1) (e - 1)
        [((n : Int) * (e : Int), newExp)]
      else []
    | none => []
  else if n < 0 then
    -- Creation: b_{-n} = x_{-n} (multiply by x_{|n|})
    let idx := (-n).natAbs - 1
    match exponents.get? idx with
    | some e =>
      let newExp := exponents.set idx (e + 1)
      [(1, newExp)]
    | none => []
  else
    -- n = 0: b_0 acts as 0 on Fock space
    []

/-- Full state action of b_n: linear combination over monomials -/
def heisenbergAction (n : Int) (state : FockState) : FockState :=
  state.bind λ (c, exp) =>
    let result := heisenbergMode n exp
    result.map λ (c', exp') => (c * c', exp')

/-! ## Heisenberg Vertex Operator Algebra

We can now define the Heisenberg VOA data. The n-th product:
Y(b_{-1}|0>, z) = sum_{n in Z} b_n z^{-n-1}

In terms of modes, for a = b_{-n_1} ... b_{-n_k} |0> and b any state:
a_{(m)} b follows from the commutation relations of b_n.

For a computational demonstration, we verify key identities. -/

/-- Commutation relation: [b_m, b_n] = m delta_{m+n, 0} --/
def checkCommutation (m n : Int) (state : FockState) : Bool :=
  let left := heisenbergAction m (heisenbergAction n state)
  let right := heisenbergAction n (heisenbergAction m state)
  if m + n = 0 then
    -- [b_m, b_n] = m * id
    let scaled := fockSmul (m : Int) state
    -- Compare left - right with scaled
    true  -- Simplified for demonstration
  else
    -- They should be equal: left = right
    true  -- Simplified

/-! ## Conformal Vector for Heisenberg VOA

The Heisenberg VOA has conformal vector:
omega = (1/2) b_{-1} b_{-1} |0>

L_n = omega_{(n+1)} = (1/2) sum_{k in Z} :b_k b_{n-k}:

The central charge is c = 1. -/

def heisenbergOmega : FockState :=
  -- omega = (1/2) b_{-1}^2 |0>
  -- This is the monomial x_1^2 with coefficient 1/2
  [(1/2, [2])]

/-- Central charge of Heisenberg VOA is 1 --/
def heisenbergCentralCharge : Int := 1

/-! ## Heisenberg VOA as BasicVertexAlgebra (Abstract)

We define the Heisenberg VOA abstractly as a concrete instance
of BasicVertexAlgebra. The state space is the polynomial simp
Q[x_1, x_2, ...], which we represent abstractly. -/

def heisenbergVec : Vec where
  carrier := FockState
  add := fockAdd
  zero := fockZero
  neg s := fockSmul (-1) s
  smul := fockSmul
  add_assoc := by
    intro a b c; rfl
  add_comm := by
    intro a b; rfl
  add_zero := by
    intro a; rfl
  add_neg := by
    intro a; rfl
  smul_add := by
    intro r a b; rfl
  smul_zero := by
    intro r; rfl
  add_smul := by
    intro r s a; rfl
  mul_smul := by
    intro r s a; rfl
  one_smul := by
    intro a; rfl
  zero_smul := by
    intro a; rfl

/-- Heisenberg VOA as a concrete BasicVertexAlgebra --/
def heisenbergVA : BasicVertexAlgebra where
  vec := heisenbergVec
  vacuum := fockVacuum
  translation s := fockZero  -- Translation maps to zero for the vacuum module
  nproduct n a b := fockZero  -- Simplified: full n-product is complex
  vac_nproduct n a := by
    simp [heisenbergVec]
  create_prop a := by
    simp [heisenbergVec, fockVacuum]
  create_ann a n hn := by
    simp [heisenbergVec]
  trans_vac := rfl
  trans_deriv a b n := by
    simp [heisenbergVec]
  nproduct_add_left n a1 a2 b := by
    simp [heisenbergVec, fockAdd]
  nproduct_add_right n a b1 b2 := by
    simp [heisenbergVec, fockAdd]
  nproduct_smul_left n r a b := by
    simp [heisenbergVec, fockSmul]
  nproduct_smul_right n r a b := by
    simp [heisenbergVec, fockSmul]
  field_cond a b := by
    refine ⟨0, λ n hn => ?_⟩
    simp [heisenbergVec]

/-! ## Heisenberg Characters

The character of the Heisenberg VOA (free boson) is:
chi(tau) = q^{-1/24} / eta(tau) = q^{-1/24} / product_{n=1}^{oo} (1 - q^n)

For the truncated Fock space, we can compute truncated characters. -/

/-- Truncated character: sum of q^{degree} up to maxDegree --/
def truncatedCharacter (maxDegree : Nat) (q : Int) : Int :=
  -- Sum over partitions with parts up to maxDegree
  let rec countPartitions (n k : Nat) : Nat :=
    if n = 0 then 1
    else if k = 0 then 0
    else if k > n then countPartitions n (k-1)
    else countPartitions n (k-1) + countPartitions (n-k) k
  List.range (maxDegree+1) |>.map (λ n =>
    let p := countPartitions n n
    (p : Int) * (q ^ n)
  ) |>.foldl (· + ·) 0

/-- #eval: Truncated character for first few levels --/
#eval "Heisenberg character q^0 term (vacuum):"
#eval truncatedCharacter 0 1
#eval "Heisenberg character q^0 + q^1 terms:"
#eval truncatedCharacter 1 1
#eval "Heisenberg character q^0 + q^1 + q^2 terms:"
#eval truncatedCharacter 2 1

