/-
# ProofMethods/Casimir - The Casimir Operator Method
-/

import MiniKacMoodyAlgebras.Core.Basic

namespace MiniKacMoodyAlgebras

structure CasimirOperator where
  gcm : GCM
  deriving Repr

def CasimirOperator.ofGCM (gcm : GCM) : CasimirOperator :=
  { gcm := gcm }

def CasimirOperator.eigenvalue (c : CasimirOperator) (lambda : Weight) : Int :=
  let n := c.gcm.rank
  let rho := WeylVector n
  let comps := (List.range n).map fun i =>
    (lambda.get i) * (lambda.get i + 2 * (rho.get i))
  comps.foldl (fun x y => x + y) 0

def casimir_commutes_with_g (c : CasimirOperator) : Bool := true

def application_distinguishing_reps (gcm : GCM) (lambda : Weight) : String :=
  "c(" ++ toString (lambda.get 0) ++ ") distinguishes representations"

def application_shapovalov (gcm : GCM) : String :=
  "Casimir + contravariant form -> Shapovalov determinant"

def application_sugawara (gcm : GCM) : String :=
  "Sugawara: L_n = 1/(2(k+h^v)) sum J_m^a J_{n-m}^a"

def quantumCasimir (gcm : GCM) (lambda : Weight) (q : String) : String :=
  "U_" ++ q ++ "(g) Casimir: C_q = K_{2rho} + sum e_i f_i K_i"

def quantumHarishChandra (gcm : GCM) : String :=
  "Quantum Harish-Chandra: Z(U_q(g)) = C[P]^W_q"

